# FCGBDS configuration — placeholders only. Do not put real secrets in git.

PORT=3001
HOST=0.0.0.0

# observe | enforce
FCGBDS_MODE=observe

FCGBDS_CHALLENGE_THRESHOLD=60
FCGBDS_BLOCK_THRESHOLD=90

# Optional expected Host header. Example: app.example
FCGBDS_EXPECTED_HOSTNAME=

FCGBDS_PROTECTED_PATHS=/login,/register,/api/auth
FCGBDS_DEFAULT_FAILURE_POLICY=fail-closed
FCGBDS_VELOCITY_MAX_HITS=20
FCGBDS_VELOCITY_WINDOW_MS=60000

# memory | redis | postgres | sqlite
FCGBDS_STORE=memory
REDIS_URL=
FCGBDS_POSTGRES_URL=
FCGBDS_SQLITE_PATH=./fcgbds.sqlite

FCGBDS_REDIS_PREFIX=fcgbds
FCGBDS_TRUST_PROXY=true
FCGBDS_HONEYPOT_FIELDS=website,homepage,company_url
FCGBDS_DATACENTER_ASNS=
FCGBDS_ASN_HEADER=x-asn
FCGBDS_TRAFFIC_LANE_HEADER=x-fcgbds-lane
FCGBDS_TLS_CLASS_HEADER=x-fcgbds-tls-class
FCGBDS_REPUTATION_CAP=50

# Optional URL you operate. FCGBDS POSTs {"ip":"..."} and reads {"score":0-100}.
FCGBDS_REPUTATION_URL=

FCGBDS_WEBHOOK_SIGNATURE_HEADER=
FCGBDS_CHALLENGE_SECRET=
FCGBDS_STORE_MAX_KEYS=5000

# Required for admin API writes and, when set, for POST /v1/evaluate.
FCGBDS_API_TOKEN=
FCGBDS_DASHBOARD_PASSWORD=
FCGBDS_SESSION_SECRET=

# Aggregate counts at GET /v1/wall. Leave false unless you want them public.
FCGBDS_WALL_PUBLIC=false

# Optional receiver for decision events. Your URL.
FCGBDS_EVENT_WEBHOOK_URL=
