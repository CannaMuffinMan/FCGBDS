# FCGBDS configuration — placeholders only

PORT=3001
HOST=0.0.0.0

# observe | enforce
FCGBDS_MODE=observe

FCGBDS_CHALLENGE_THRESHOLD=60
FCGBDS_BLOCK_THRESHOLD=90

# Optional. Example: api.example.com
FCGBDS_EXPECTED_HOSTNAME=

# Comma-separated path prefixes inserted as a fail-closed profile
FCGBDS_PROTECTED_PATHS=/login,/register,/api/auth
FCGBDS_DEFAULT_FAILURE_POLICY=fail-closed
FCGBDS_VELOCITY_MAX_HITS=20
FCGBDS_VELOCITY_WINDOW_MS=60000

# Optional Redis. Leave empty to use in-process memory.
REDIS_URL=

FCGBDS_REDIS_PREFIX=fcgbds
FCGBDS_TRUST_PROXY=true
FCGBDS_HONEYPOT_FIELDS=website,homepage,company_url

# Comma-separated ASN numbers treated as datacenter (requires trusted ASN header)
FCGBDS_DATACENTER_ASNS=
FCGBDS_ASN_HEADER=x-asn
FCGBDS_TRAFFIC_LANE_HEADER=x-fcgbds-lane

# Header name that must be present for webhook allowlist (value not verified)
FCGBDS_WEBHOOK_SIGNATURE_HEADER=

# Long random string in any shared install
FCGBDS_CHALLENGE_SECRET=

FCGBDS_STORE_MAX_KEYS=5000
