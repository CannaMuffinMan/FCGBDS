{
  "name": "fcgbds",
  "version": "2.1.0",
  "description": "Config-driven bot defense middleware you can run on your own server.",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:adapters": "cd sdk/go && go test ./... && cd ../.. && PYTHONPATH=sdk/python python3 sdk/python/tests/test_middleware.py",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "harness": "tsx src/harness.ts"
  },
  "keywords": [
    "bot-detection",
    "bot-defense",
    "middleware",
    "rate-limiting",
    "security",
    "typescript",
    "redis"
  ],
  "author": "CannaMuffinMan / Forever Couch Gang",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
